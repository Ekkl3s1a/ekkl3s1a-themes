{
    "$schema": "vscode://schemas/color-theme",
    "name": "Burgundy Night",
    "type": "dark",
    "semanticHighlighting": true,
    "colors": {
        "focusBorder": "#7b1e3a",

        "editor.background": "#14070D",
        "editor.foreground": "#E9D7DE",
        "editorLineNumber.foreground": "#6b3a4a",
        "editorLineNumber.activeForeground": "#D9B9C5",
        "editorCursor.foreground": "#E04F7B",

        "editor.selectionBackground": "#7b1e3a55",
        "editor.inactiveSelectionBackground": "#7b1e3a2A",
        "editor.lineHighlightBackground": "#1C0A12",
        "editorWhitespace.foreground": "#3A1A25",
        "editorIndentGuide.background1": "#2B111B",
        "editorIndentGuide.activeBackground1": "#7b1e3a",

        "activityBar.background": "#0F0509",
        "activityBar.foreground": "#F2D6E1",
        "activityBar.inactiveForeground": "#B892A0",
        "activityBarBadge.background": "#7b1e3a",
        "activityBarBadge.foreground": "#FFFFFF",

        "sideBar.background": "#10060B",
        "sideBar.foreground": "#E9D7DE",
        "sideBarTitle.foreground": "#F2D6E1",

        "titleBar.activeBackground": "#0F0509",
        "titleBar.activeForeground": "#F2D6E1",
        "titleBar.inactiveBackground": "#0C0407",
        "titleBar.inactiveForeground": "#B892A0",

        "statusBar.background": "#0F0509",
        "statusBar.foreground": "#F2D6E1",
        "statusBar.debuggingBackground": "#7b1e3a",
        "statusBar.debuggingForeground": "#FFFFFF",

        "tab.activeBackground": "#14070D",
        "tab.activeForeground": "#F2D6E1",
        "tab.inactiveBackground": "#0F0509",
        "tab.inactiveForeground": "#B892A0",
        "tab.activeBorderTop": "#7b1e3a",

        "panel.background": "#0F0509",
        "panel.border": "#2B111B",

        "terminal.background": "#14070D",
        "terminal.foreground": "#E9D7DE",
        "terminal.ansiRed": "#E04F7B",
        "terminal.ansiGreen": "#7FD1AE",
        "terminal.ansiYellow": "#EBCB8B",
        "terminal.ansiBlue": "#8FA8FF",
        "terminal.ansiMagenta": "#C77DFF",
        "terminal.ansiCyan": "#66D9EF",
        "terminal.ansiWhite": "#E9D7DE",

        /* =========================
        BRACKET NESTING (DEPTH)
        ========================= */
        "editorBracketHighlight.foreground1": "#E04F7B",
        "editorBracketHighlight.foreground2": "#FFC2D7",
        "editorBracketHighlight.foreground3": "#7FD1AE",
        "editorBracketHighlight.foreground4": "#8FA8FF",
        "editorBracketHighlight.foreground5": "#C77DFF",
        "editorBracketHighlight.foreground6": "#EBCB8B",
        "editorBracketHighlight.unexpectedBracket.foreground": "#FF6B8B",

        /* =========================
        BRACKET GUIDES
        ========================= */
        "editorBracketPairGuide.background1": "#E04F7B44",
        "editorBracketPairGuide.background2": "#FFC2D744",
        "editorBracketPairGuide.background3": "#7FD1AE44",
        "editorBracketPairGuide.background4": "#8FA8FF44",
        "editorBracketPairGuide.background5": "#C77DFF44",
        "editorBracketPairGuide.background6": "#EBCB8B44",

        "editorBracketPairGuide.activeBackground1": "#E04F7B88",
        "editorBracketPairGuide.activeBackground2": "#FFC2D788",
        "editorBracketPairGuide.activeBackground3": "#7FD1AE88",
        "editorBracketPairGuide.activeBackground4": "#8FA8FF88",
        "editorBracketPairGuide.activeBackground5": "#C77DFF88",
        "editorBracketPairGuide.activeBackground6": "#EBCB8B88"
    },
    "tokenColors": [
        {
            "scope": [
                "comment",
                "punctuation.definition.comment"
            ],
            "settings": { "foreground": "#9A6A7A", "fontStyle": "italic" }
        },
        {
            "scope": [
                "string",
                "punctuation.definition.string"
            ],
            "settings": { "foreground": "#FFC2D7" }
        },
        {
            "scope": [
                "keyword",
                "storage.type"
            ],
            "settings": { "foreground": "#E04F7B" }
        },
        {
            "scope": [
                "keyword",
                "storage.modifier"
            ],
            "settings": { "foreground": "#F2A3B8" }
        },
        {
            "scope": [
                "keyword",
                "keyword.control"
            ],
            "settings": { "foreground": "#F2A3B8" }
        },
        {
            "scope": [
                "constant.numeric",
                "constant.language"
            ],
            "settings": { "foreground": "#EBCB8B" }
        },
        {
            "scope": [
                "entity.name.function"
            ],
            "settings": { "foreground": "#E04F7B" }
        },
        {
            "scope": [
                "support.function"
            ],
            "settings": { "foreground": "#EBCB8B" }
        },
        {
            "scope": [
                "entity.name.type",
                "support.type"
            ],
            "settings": { "foreground": "#D2A8FF" }
        },
        {
            "scope": [
                "variable",
                "identifier"
            ],
            "settings": { "foreground": "#E9D7DE" }
        },

        /* =========================
        BRACKET TYPE COLORING
        ========================= */
        {
            "name": "Curly braces {}",
            "scope": [
                "punctuation.curlybrace.open",
                "punctuation.curlybrace.close",
                "meta.brace.curly"
            ],
            "settings": { "foreground": "#E04F7B" }
        },
        {
            "name": "Square brackets []",
            "scope": [
                "punctuation.squarebracket.open",
                "punctuation.squarebracket.close"
            ],
            "settings": { "foreground": "#8FA8FF" }
        },
        {
            "name": "Parentheses ()",
            "scope": [
                "punctuation.parenthesis.open",
                "punctuation.parenthesis.close",
                "meta.brace.round"
            ],
            "settings": { "foreground": "#C77DFF" }
        },

        /* =========================
        ANGULAR / HTML SUPPORT
        ========================= */
        {
            "name": "HTML Tags",
            "scope": [
                "entity.name.tag",
                "entity.name.tag.html"
            ],
            "settings": { "foreground": "#E04F7B" }
        },
        {
            "name": "HTML Closing Tags",
            "scope": [
                "entity.name.tag.end",
                "entity.name.tag.structure"
            ],
            "settings": { "foreground": "#E04F7B" }
        },
        {
            "name": "HTML Attribute Names",
            "scope": [
                "entity.other.attribute-name",
                "entity.other.attribute-name.html"
            ],
            "settings": { "foreground": "#FFC2D7" }
        },
        {
            "name": "HTML Attribute Values",
            "scope": [
                "string.quoted",
                "string.quoted.double.html",
                "string.quoted.single.html"
            ],
            "settings": { "foreground": "#7FD1AE" }
        },
        {
            "name": "Angular Template Expression Variables",
            "scope": [
                "variable.other.readwrite.angular",
                "variable.other.component",
                "meta.template.expression variable"
            ],
            "settings": {
                "foreground": "#E9D7DE"
            }
        },
        {
            "name": "Angular Template Functions",
            "scope": [
                "meta.template.expression entity.name.function"
            ],
            "settings": {
                "foreground": "#7FD1AE"
            }
        },

        /* ==== Angular Bindings ==== */
        {
            "name": "Angular Property Binding [value]",
            "scope": [
                "meta.directive.property-binding",
                "meta.attribute.angular"
            ],
            "settings": { "foreground": "#8FA8FF" }
        },
        {
            "name": "Angular Event Binding (click)",
            "scope": [
                "meta.directive.event-binding"
            ],
            "settings": { "foreground": "#EBCB8B" }
        },
        {
            "name": "Angular Structural Directive *ngIf, *ngFor",
            "scope": [
                "entity.other.attribute-name.structural.directive.angular",
                "meta.directive.structural"
            ],
            "settings": {
                "foreground": "#C77DFF",
                "fontStyle": "italic"
            }
        },

        /* ==== Angular Interpolation ==== */
        {
            "name": "Angular Interpolation {{ }}",
            "scope": [
                "meta.interpolation",
                "meta.template.expression"
            ],
            "settings": { "foreground": "#E9D7DE" }
        },
        {
            "name": "Interpolation Brackets",
            "scope": [
                "punctuation.definition.interpolation.begin",
                "punctuation.definition.interpolation.end"
            ],
            "settings": { "foreground": "#E04F7B" }
        },

        /* =========================
        ANGULAR PIPES
        ========================= */
        {
            "name": "Angular Pipe Operator |",
            "scope": [
                "keyword.operator.pipe",
                "punctuation.separator.pipe",
                "keyword.operator.angular"
            ],
            "settings": {
                "foreground": "#EBCB8B"
            }
        },
        {
            "name": "Angular Pipe Name (date, async, etc)",
            "scope": [
                "support.pipe",
                "entity.name.function.pipe",
                "entity.name.function.pipe.angular"
            ],
            "settings": {
                "foreground": "#C77DFF"
            }
        },
        {
            "name": "Angular Async Pipe",
            "scope": [
                "entity.name.function.pipe.async",
                "support.pipe.async"
            ],
            "settings": {
                "foreground": "#E04F7B",
                "fontStyle": "bold"
            }
        },
        {
            "name": "Angular Pipe Arguments",
            "scope": [
                "meta.pipe.arguments",
                "meta.expression.pipe"
            ],
            "settings": {
                "foreground": "#7FD1AE"
            }
        },
        {
            "name": "Async Pipe Highlight (fallback)",
            "scope": [
                "string.unquoted.pipe.async",
                "meta.expression.pipe.async"
            ],
            "settings": {
                "foreground": "#E04F7B",
                "fontStyle": "bold underline"
            }
        },

        /* =========================
        ANGULAR SERVICES (TS)
        ========================= */
        {
            "name": "Injected Services (constructor/private readonly)",
            "scope": [
                "variable.parameter",
                "meta.parameter.object-binding-pattern"
            ],
            "settings": {
                "foreground": "#FFC2D7"
            }
        },
        {
            "name": "Service Usage (this.userService)",
            "scope": [
                "variable.other.object.property",
                "meta.object-literal.key"
            ],
            "settings": {
                "foreground": "#F2A3B8"
            }
        },

        /* =========================
        ✅ DIRECTIVE vs INPUT vs OUTPUT
        ========================= */
        {
            "name": "Angular Structural Directive (*ngIf, *ngFor)",
            "scope": [
                "entity.other.attribute-name.structural.directive.angular",
                "meta.directive.structural"
            ],
            "settings": {
                "foreground": "#C77DFF",
                "fontStyle": "bold italic"
            }
        },
        {
            "name": "Angular Input Binding [value]",
            "scope": [
                "meta.directive.property-binding",
                "entity.other.attribute-name.property-binding"
            ],
            "settings": {
                "foreground": "#8FA8FF"
            }
        },
        {
            "name": "Angular Output Binding (click)",
            "scope": [
                "meta.directive.event-binding",
                "entity.other.attribute-name.event-binding"
            ],
            "settings": {
                "foreground": "#EBCB8B",
                "fontStyle": "bold"
            }
        },

        /* =========================
        ✅ SYNC vs ASYNC VALUES
        ========================= */

        /* Observable variables (user$) */
        {
            "name": "Observable Variables ($ suffix)",
            "scope": [
                "variable.other.readwrite",
                "variable.other.object.property"
            ],
            "settings": {
                "foreground": "#FFC2D7"
            }
        },

        /* Async pipe result emphasis */
        {
            "name": "Async Pipe Result",
            "scope": [
                "meta.expression.pipe.async",
                "meta.template.expression.pipe.async"
            ],
            "settings": {
                "foreground": "#E04F7B",
                "fontStyle": "bold underline"
            }
        },

        /* Pipe chain highlighting */
        {
            "name": "Pipe Chain Expression",
            "scope": [
                "meta.expression.pipe"
            ],
            "settings": {
                "foreground": "#F2A3B8"
            }
        },

        /* =========================
        ✅ RxJS OPERATORS
        ========================= */
        {
            "name": "RxJS Operators (pipe(map, switchMap, etc))",
            "scope": [
                "entity.name.function.rxjs",
                "support.function.rxjs",
                "meta.import variable.other.readwrite",
                "meta.function-call variable.function"
            ],
            "settings": {
                "foreground": "#EBCB8B",
                "fontStyle": "italic"
            }
        },
        {
            "name": "RxJS pipe() function",
            "scope": [
                "entity.name.function.pipe",
                "support.function.pipe"
            ],
            "settings": {
                "foreground": "#E04F7B",
                "fontStyle": "bold"
            }
        },

        /* =========================
        ✅ Observable Heuristic Highlight
        ========================= */
        {
            "name": "Observable Variables (heuristic)",
            "scope": [
                "variable.other.readwrite",
                "variable.other.object.property",
                "meta.definition.variable"
            ],
            "settings": {
                "foreground": "#FFC2D7",
                "fontStyle": "italic"
            }
        },

        /* =========================
        ✅ Angular Pipes Differentiation
        ========================= */

        /* Built-in pipes (date, async, uppercase...) */
        {
            "name": "Angular Built-in Pipes",
            "scope": [
                "support.pipe",
                "entity.name.function.pipe.angular"
            ],
            "settings": {
                "foreground": "#C77DFF"
            }
        },

        /* Custom pipes */
        {
            "name": "Angular Custom Pipes",
            "scope": [
                "entity.name.function.pipe.custom",
                "meta.pipe.custom"
            ],
            "settings": {
                "foreground": "#D8B4FE",
                "fontStyle": "italic"
            }
        },

        /* =========================
        ✅ async as user
        ========================= */

        /* 'as' keyword */
        {
            "name": "Angular Template 'as' keyword",
            "scope": [
                "keyword.control.as",
                "meta.template.expression keyword"
            ],
            "settings": {
                "foreground": "#EBCB8B",
                "fontStyle": "bold"
            }
        },

        /* variable after 'as' */
        {
            "name": "Angular Template Alias Variable",
            "scope": [
                "meta.template.expression variable.other.alias",
                "variable.other.alias"
            ],
            "settings": {
                "foreground": "#7FD1AE",
                "fontStyle": "bold"
            }
        },

        /* =========================
        ✅ Template Variables (let item)
        ========================= */
        {
            "name": "Angular Template Variable (let item)",
            "scope": [
                "variable.other.template",
                "meta.template.variable variable"
            ],
            "settings": {
                "foreground": "#7FD1AE",
                "fontStyle": "italic"
            }
        },

        /* 'let' keyword */
        {
            "name": "Angular 'let' keyword",
            "scope": [
                "keyword.declaration.let",
                "meta.template.expression keyword"
            ],
            "settings": {
                "foreground": "#E04F7B"
            }
        },

        /* =========================
        ✅ RXJS OPERATOR COLORS
        ========================= */

        /* map (transform) */
        {
            "name": "RxJS map",
            "scope": [
                "meta.function-call variable.function.map"
            ],
            "settings": {
                "foreground": "#7FD1AE"
            }
        },

        /* switchMap (async switching) */
        {
            "name": "RxJS switchMap",
            "scope": [
                "meta.function-call variable.function.switchmap"
            ],
            "settings": {
                "foreground": "#E04F7B",
                "fontStyle": "bold"
            }
        },

        /* mergeMap (parallel async) */
        {
            "name": "RxJS mergeMap",
            "scope": [
                "meta.function-call variable.function.mergemap"
            ],
            "settings": {
                "foreground": "#8FA8FF"
            }
        },

        /* tap (side effects) */
        {
            "name": "RxJS tap",
            "scope": [
                "meta.function-call variable.function.tap"
            ],
            "settings": {
                "foreground": "#C77DFF",
                "fontStyle": "italic"
            }
        },

        /* filter */
        {
            "name": "RxJS filter",
            "scope": [
                "meta.function-call variable.function.filter"
            ],
            "settings": {
                "foreground": "#EBCB8B"
            }
        },

        /* catchError */
        {
            "name": "RxJS catchError",
            "scope": [
                "meta.function-call variable.function.catcherror"
            ],
            "settings": {
                "foreground": "#FF6B8B",
                "fontStyle": "bold"
            }
        },

        /* =========================
        ✅ ANGULAR TEMPLATE UX STATES
        ========================= */

        /* Error-like expressions */
        {
            "name": "Angular Template Error",
            "scope": [
                "invalid",
                "invalid.illegal",
                "invalid.deprecated"
            ],
            "settings": {
                "foreground": "#FF6B8B",
                "fontStyle": "underline"
            }
        },

        /* Warning-like (optional/null) */
        {
            "name": "Angular Optional / Nullable",
            "scope": [
                "keyword.operator.optional",
                "punctuation.accessor.optional"
            ],
            "settings": {
                "foreground": "#EBCB8B"
            }
        },

        /* Safe navigation operator (?.) */
        {
            "name": "Angular Safe Navigation",
            "scope": [
                "punctuation.accessor.safe",
                "keyword.operator.safe-navigation"
            ],
            "settings": {
                "foreground": "#FFC2D7",
                "fontStyle": "italic"
            }
        },

        /* Async loading emphasis */
        {
            "name": "Async Loading Context",
            "scope": [
                "meta.expression.pipe.async"
            ],
            "settings": {
                "foreground": "#E04F7B",
                "fontStyle": "bold underline"
            }
        },

        /* =========================
        ✅ RXJS INTENSITY GRADIENT
        ========================= */

        /* map – light transform */
        {
            "name": "RxJS map (low intensity)",
            "scope": [
                "meta.function-call variable.function.map"
            ],
            "settings": {
                "foreground": "#A3D9C0"
            }
        },

        /* switchMap – medium */
        {
            "name": "RxJS switchMap (medium intensity)",
            "scope": [
                "meta.function-call variable.function.switchmap"
            ],
            "settings": {
                "foreground": "#E04F7B",
                "fontStyle": "bold"
            }
        },

        /* mergeMap – parallel */
        {
            "name": "RxJS mergeMap (parallel)",
            "scope": [
                "meta.function-call variable.function.mergemap"
            ],
            "settings": {
                "foreground": "#8FA8FF"
            }
        },

        /* exhaustMap – strongest */
        {
            "name": "RxJS exhaustMap (max intensity)",
            "scope": [
                "meta.function-call variable.function.exhaustmap"
            ],
            "settings": {
                "foreground": "#66D9EF",
                "fontStyle": "bold underline"
            }
        },

        /* =========================
        ✅ RXJS FLOW COLORING
        ========================= */

        /* stream source (observable creation) */
        {
            "name": "RxJS Source",
            "scope": [
                "meta.definition.variable",
                "variable.other.readwrite"
            ],
            "settings": {
                "foreground": "#E04F7B"
            }
        },

        /* transformation chain */
        {
            "name": "RxJS Transform Stage",
            "scope": [
                "meta.function-call"
            ],
            "settings": {
                "foreground": "#7FD1AE"
            }
        },

        /* async boundary */
        {
            "name": "RxJS Async Boundary",
            "scope": [
                "meta.function-call variable.function.switchmap",
                "meta.function-call variable.function.mergemap",
                "meta.function-call variable.function.exhaustmap"
            ],
            "settings": {
                "foreground": "#66D9EF"
            }
        },

        /* side effects */
        {
            "name": "RxJS Side Effect",
            "scope": [
                "meta.function-call variable.function.tap"
            ],
            "settings": {
                "foreground": "#C77DFF",
                "fontStyle": "italic"
            }
        },

        /* =========================
        ✅ ANGULAR SIGNALS
        ========================= */

        /* signal() */
        {
            "name": "Angular signal()",
            "scope": [
                "meta.function-call variable.function.signal"
            ],
            "settings": {
                "foreground": "#E04F7B",
                "fontStyle": "bold"
            }
        },

        /* computed() */
        {
            "name": "Angular computed()",
            "scope": [
                "meta.function-call variable.function.computed"
            ],
            "settings": {
                "foreground": "#7FD1AE"
            }
        },

        /* effect() */
        {
            "name": "Angular effect()",
            "scope": [
                "meta.function-call variable.function.effect"
            ],
            "settings": {
                "foreground": "#C77DFF",
                "fontStyle": "italic"
            }
        },

        /* signal usage count() */
        {
            "name": "Angular signal read",
            "scope": [
                "meta.function-call variable.function"
            ],
            "settings": {
                "foreground": "#FFC2D7"
            }
        }

    ],

    "semanticTokenColors": {
        /* =========================
        VARIABLES
        ========================= */
        "variable": "#E9D7DE",
        "variable.readonly": "#FFC2D7",
        "variable.defaultLibrary": "#8FA8FF",

        /* =========================
        PARAMETERS
        ========================= */
        "parameter": "#FFC2D7",

        /* =========================
        FUNCTIONS / METHODS
        ========================= */
        "function": "#E04F7B",
        "method": "#F2A3B8",

        /* =========================
        TYPES / CLASSES
        ========================= */
        "type": "#D2A8FF",
        "class": "#D2A8FF",
        "interface": "#C77DFF",
        "enum": "#EBCB8B",

        /* =========================
        KEYWORDS
        ========================= */
        "keyword": "#E04F7B",

        /* =========================
        STRINGS & NUMBERS
        ========================= */
        "string": "#FFC2D7",
        "number": "#EBCB8B",

        /* =========================
        SPECIAL CASES
        ========================= */
        "property": "#F2D6E1",
        "namespace": "#8FA8FF",

        /* =========================
        MODIFIERS (TS MAGIC ✨)
        ========================= */
        "variable:readonly": "#FFC2D7",
        "parameter:readonly": "#FFC2D7",
        "function:defaultLibrary": "#9A4A60",

        /* =========================
        EXTRA SEMANTIC TUNING
        ========================= */
        "property.readonly": "#FFC2D7",
        "property.defaultLibrary": "#8FA8FF",
        "parameter.declaration": "#FFC2D7",
        "variable.local": "#E9D7DE",
        "function.async": "#E04F7B",
        "method.declaration": "#E04F7B",
        "class.defaultLibrary": "#D2A8FF",

        /* =========================
        ANGULAR SERVICES (SEMANTIC)
        ========================= */
        "variable.injected": "#FFC2D7",
        "property.injected": "#FFC2D7",

        "class.service": "#D2A8FF",
        "type.service": "#D2A8FF",

        "variable.member": "#F2A3B8",
        "property.member": "#F2A3B8",

        /* =========================
        ✅ SYNC vs ASYNC (SEMANTIC)
        ========================= */

        /* Observable variables (user$) */
        "variable.async": {
            "foreground": "#E04F7B",
            "fontStyle": "italic"
        },

        /* Observable properties */
        "property.async": {
            "foreground": "#E04F7B"
        },

        /* Reactive streams (RxJS style) */
        "variable.reactive": "#E04F7B",

        /* Emphasize injected reactive services */
        "variable.injected.async": {
            "foreground": "#7FD1AE"
        },

        /* =========================
        ✅ RXJS + ASYNC SEMANTIC
        ========================= */

        /* Observable variables */
        "variable.observable": {
